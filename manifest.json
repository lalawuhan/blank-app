{
  "manifestVersion": 5,
  "id": "com.indesign.documentgenerator.uxp",
  "name": "Document Generator",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "documentgenerator",
      "label": {
        "default": "Document Generator"
      },
      "minimumSize": {
        "width": 400,
        "height": 600
      },
      "maximumSize": {
        "width": 800,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 400,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 600
      }
    }
  ],
  "requiredPermissions": [
    "launchProcess",
    "network",
    "allowCodeGenerationFromStrings",
    "ipc",
    "webview",
    {
      "module": "fs",
      "requiredAccess": "readAndWrite"
    },
    {
      "module": "os"
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ]
    }
  ]
}
